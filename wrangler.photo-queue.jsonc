{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "offerget-photo-consumer",
  "main": "workers/photo-consumer.ts",
  "compatibility_date": "2026-07-24",
  "kv_namespaces": [{ "binding": "PHOTO_JOBS", "id": "ffbc72ee42f840a7bf156aa49df4fb3c" }],
  "services": [{ "binding": "APP", "service": "offerget" }],
  "queues": { "consumers": [{ "queue": "offerget-photo-jobs", "max_batch_size": 1, "max_retries": 3 }] }
}
