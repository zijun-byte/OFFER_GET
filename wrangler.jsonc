{
    "$schema":  "./node_modules/wrangler/config-schema.json",
    "name":  "offerget",
    "main":  ".open-next/worker.js",
    "compatibility_date":  "2026-07-24",
    "compatibility_flags":  [
                                "nodejs_compat",
                                "global_fetch_strictly_public"
                            ],
    "assets":  {
                   "directory":  ".open-next/assets",
                   "binding":  "ASSETS"
               },
    "kv_namespaces": [{ "binding": "PHOTO_JOBS", "id": "ffbc72ee42f840a7bf156aa49df4fb3c" }],
    "queues": { "producers": [{ "binding": "PHOTO_QUEUE", "queue": "offerget-photo-jobs" }] }
}
